# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# GitHub personal access token (classic: `repo` scope; fine-grained: Pull requests read)
GITHUB_TOKEN=
# GitHub orgs to show PRs from, comma-separated; one section per org
GITHUB_ORGS=
# Linear display names of people to switch between (sidebar); empty = only you.
# Their GitHub logins come from the GitHub account each one linked in Linear.
TT_USERS=
